<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<title>Botões Acessíveis</title>
<style>
button {
    font-size: 24px; 
    padding: 20px;
    margin: 10px;
}
</style>
</head>
<body>
<h2>Interface Acessível</h2>
